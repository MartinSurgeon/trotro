<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the Compose background so there is no flash on launch. -->
    <style name="Theme.Dawuro" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Launch theme: the gong-gong bell on Ghana green, then hands over to Theme.Dawuro. -->
    <style name="Theme.Dawuro.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ghana_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Dawuro</item>
    </style>
</resources>
